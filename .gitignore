# ---- Node / TypeScript ----
node_modules/
dist/
build/
*.tsbuildinfo
.vite/
coverage/
*.log
npm-debug.log*

# ---- .NET ----
# Scoped to the .NET app rather than written as a bare `bin/`. An unanchored
# rule matches at every depth, and CDK's convention is `bin/` for the app
# entry point — so `bin/` here silently stopped infra/bin/infra.ts from ever
# being committed, and the pipeline failed on a missing module in a file that
# looked present locally.
apps/api-dotnet/**/bin/
apps/api-dotnet/**/obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
TestResults/
*.trx
*.coverage
*.coverenv

# ---- SQLite (local dev databases are not source) ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---- AWS CDK ----
cdk.out/
cdk.context.json
.cdk.staging/

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# One exception: the web client's defaults are committed so a reviewer can
# clone and run without a setup step. Nothing in it is secret — a Cognito
# domain and a public client id, both visible to any browser that logs in,
# plus localhost URLs. The negation is scoped to that one path, so every
# other .env anywhere in the tree stays ignored. Personal overrides go in
# apps/web/.env.local, which is still ignored.
!apps/web/.env
*.pem

# ---- Editor / OS ----
# Shared workspace config is committed (Peacock theme is SteelSeries orange,
# plus launch/task definitions for running both APIs); personal state is not.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db
