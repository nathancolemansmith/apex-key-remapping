                "mappings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mappings\": [\n    {\n      \"from\": \"0x04\",\n      \"to\": \"0x04\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Remapping a key back to itself removes the override."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT replace mappings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mappings\": [\n    {\n      \"from\": \"0x04\",\n      \"to\": \"0x1D\"\n    },\n    {\n      \"from\": \"0x21\",\n      \"to\": \"0x1F\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Declarative and idempotent: the request body becomes the complete set\nof remappings and anything absent from it is cleared. The right fit for\na client that owns the whole layout, such as a configuration UI with a\nSave button.\n"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE one mapping",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings/0x04",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings",
                "0x04"
              ]
            },
            "description": "Idempotent: clearing a key that was not remapped still returns 204, so\na client retrying after a dropped response does not see a spurious\nerror. A `hidCode` that is not a key on this keyboard is a 400, because\nthat is a malformed request rather than a missing resource.\n"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE all mappings",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "description": "Idempotent. Succeeds whether or not anything was remapped, and leaves\nthe keyboard itself owned.\n"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Scenario — the brief, end to end",
      "description": "Run this folder in order (Postman Runner, or `npm run postman:test`). It walks the behavior the assessment asks for and checks the answers, rather than only checking that the routes exist.",
      "item": [
        {
          "name": "1. Start from a clean layout",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "description": "Idempotent, so this is safe whether or not anything was remapped."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Assign the brief's mappings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mappings\": [\n    {\n      \"from\": \"0x04\",\n      \"to\": \"0x1D\"\n    },\n    {\n      \"from\": \"0x21\",\n      \"to\": \"0x1F\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "\"A (0x04)\" should remap to \"Z (0x1D)\", and \"4 (0x21)\" to \"2 (0x1F)\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Read back the full layout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "description": "Every key on the keyboard, remapped or not, as the brief requires."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns every key, remapped or not\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.totalKeys).to.eql(92);",
                  "    pm.expect(body.keys).to.have.lengthOf(92);",
                  "    pm.expect(body.keyboardSlug).to.eql(\"apex-pro-gen-3\");",
                  "});",
                  "pm.test(\"every key reports an effective target\", () => {",
                  "    // An un-remapped key maps to itself rather than null, so a client",
                  "    // never has to special-case the two states.",
                  "    pm.response.json().keys.forEach((key) => {",
                  "        pm.expect(key.mappedTo, `${key.hidCodeHex} mappedTo`).to.be.an(\"object\");",
                  "        if (!key.isRemapped) pm.expect(key.mappedTo.hidCode).to.eql(key.hidCode);",
                  "    });",
                  "});",
                  "pm.test(\"keys are in ascending HID code order\", () => {",
                  "    const codes = pm.response.json().keys.map((k) => k.hidCode);",
                  "    pm.expect(codes).to.eql([...codes].sort((a, b) => a - b));",
                  "});",
                  "pm.test(\"exactly the two requested keys are remapped\", () => {",
                  "    pm.expect(pm.response.json().remappedCount).to.eql(2);",
                  "});",
                  "pm.test(\"A maps to Z, and 4 maps to 2\", () => {",
                  "    const keys = pm.response.json().keys;",
                  "    const find = (code) => keys.find((k) => k.hidCode === code);",
                  "",
                  "    pm.expect(find(0x04).name).to.eql(\"A\");",
                  "    pm.expect(find(0x04).isRemapped).to.be.true;",
                  "    pm.expect(find(0x04).mappedTo.name).to.eql(\"Z\");",
                  "    pm.expect(find(0x04).mappedTo.hidCodeHex).to.eql(\"0x1D\");",
                  "",
                  "    pm.expect(find(0x21).name).to.eql(\"4\");",
                  "    pm.expect(find(0x21).mappedTo.name).to.eql(\"2\");",
                  "});",
                  "pm.test(\"remapping A to Z leaves Z itself alone\", () => {",
                  "    const z = pm.response.json().keys.find((k) => k.hidCode === 0x1D);",
                  "    pm.expect(z.isRemapped).to.be.false;",
                  "    pm.expect(z.mappedTo.hidCode).to.eql(0x1D);",
                  "});"
                ]
              }
            }
          ]
        },
