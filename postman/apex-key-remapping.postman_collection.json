        {
          "name": "5. Clearing one binding by mapping it to itself",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mappings\": [\n    {\n      \"from\": \"0x04\",\n      \"to\": \"0x04\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Regression guard. Validation strips identity mappings before the merge sees them, so this path was once silently a no-op while both halves passed their own unit tests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Only the cleared key went away",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"one of the two remains\", () => {",
                  "    pm.expect(pm.response.json().remappedCount).to.eql(1);",
                  "});",
                  "pm.test(\"0x04 was cleared and 0x21 survived\", () => {",
                  "    const remapped = pm.response.json().keys.filter((k) => k.isRemapped).map((k) => k.hidCode);",
                  "    pm.expect(remapped).to.eql([0x21]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "7. An invalid remap is rejected with every error at once",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mappings\": [\n    {\n      \"from\": \"0x04\",\n      \"to\": \"0x64\"\n    },\n    {\n      \"from\": \"0x05\",\n      \"to\": \"0x06\"\n    },\n    {\n      \"from\": \"0x05\",\n      \"to\": \"0x07\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "0x64 is a real HID usage code but not a key on this keyboard, and 0x05 appears twice as a source. Both are reported together, and the request changes nothing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"is RFC 9457 problem details\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.all.keys(\"type\", \"title\", \"status\", \"detail\", ...(body.errors ? [\"errors\"] : []));",
                  "    pm.expect(body.status).to.eql(400);",
                  "});",
                  "pm.test(\"reports both problems, not just the first\", () => {",
                  "    const errors = pm.response.json().errors;",
                  "    pm.expect(errors).to.have.lengthOf(2);",
                  "    pm.expect(errors[0]).to.deep.include({ index: 0, field: \"to\" });",
                  "    pm.expect(errors[0].message).to.include(\"not a key on\");",
                  "    pm.expect(errors[1]).to.deep.include({ index: 2, field: \"from\" });",
                  "    pm.expect(errors[1].message).to.include(\"remapped more than once\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "8. The rejected request changed nothing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"still just the one mapping\", () => {",
                  "    pm.expect(pm.response.json().remappedCount).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "9. An unknown keyboard is a 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/model-m/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "model-m",
                "mappings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"is RFC 9457 problem details\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.all.keys(\"type\", \"title\", \"status\", \"detail\", ...(body.errors ? [\"errors\"] : []));",
                  "    pm.expect(body.status).to.eql(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
