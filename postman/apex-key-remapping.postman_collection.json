{
  "info": {
    "name": "Apex Key Remapping",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Apex Key Remapping API 1.0.0\n\nGENERATED from packages/api-contract/openapi.yaml — regenerate with `npm run catalog:generate`'s sibling, `npm run postman:generate`, rather than editing here.\n\nPoint {{baseUrl}} at either implementation; both answer the same contract. Run the scenario folder in order with the Collection Runner, or headlessly with `npm run postman:test`."
  },
  "item": [
    {
      "name": "Health",
      "description": "Unauthenticated liveness probe.",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Unauthenticated. Used by the ALB target group and by CI smoke tests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"reports healthy\", () => pm.expect(pm.response.json().status).to.eql(\"healthy\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Keyboards",
      "description": "Which models this service supports.",
      "item": [
        {
          "name": "GET /api/keyboards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards"
              ]
            },
            "description": "Returns every model in the catalog, each flagged with whether the\ncalling user already owns one. A user's keyboard is provisioned on\nfirst write, so `owned` is false until they save a mapping.\n"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"includes the Apex Pro Gen 3 with 92 keys\", () => {",
                  "    const model = pm.response.json().keyboards.find((k) => k.slug === \"apex-pro-gen-3\");",
                  "    pm.expect(model, \"apex-pro-gen-3 missing\").to.be.an(\"object\");",
                  "    pm.expect(model.totalKeys).to.eql(92);",
                  "    pm.expect(model.owned).to.be.a(\"boolean\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Mappings",
      "description": "The read and write operations. Each targets {{keyboard}}, which accepts the slug or the display name.",
      "item": [
        {
          "name": "GET mappings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "description": "Returns every key on the keyboard in HID code order, remapped or not,\nas the brief requires. An un-remapped key reports `mappedTo` as itself\nrather than null, so a client can render the effective layout without\nspecial-casing either state.\n\nA caller who has never written a mapping gets the model's full key list\nwith `remappedCount` of 0 rather than a 404.\n"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns every key, remapped or not\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.totalKeys).to.eql(92);",
                  "    pm.expect(body.keys).to.have.lengthOf(92);",
                  "    pm.expect(body.keyboardSlug).to.eql(\"apex-pro-gen-3\");",
                  "});",
                  "pm.test(\"every key reports an effective target\", () => {",
                  "    // An un-remapped key maps to itself rather than null, so a client",
                  "    // never has to special-case the two states.",
                  "    pm.response.json().keys.forEach((key) => {",
                  "        pm.expect(key.mappedTo, `${key.hidCodeHex} mappedTo`).to.be.an(\"object\");",
                  "        if (!key.isRemapped) pm.expect(key.mappedTo.hidCode).to.eql(key.hidCode);",
                  "    });",
                  "});",
                  "pm.test(\"keys are in ascending HID code order\", () => {",
                  "    const codes = pm.response.json().keys.map((k) => k.hidCode);",
                  "    pm.expect(codes).to.eql([...codes].sort((a, b) => a - b));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST add mappings — the brief's example",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mappings\": [\n    {\n      \"from\": \"0x04\",\n      \"to\": \"0x1D\"\n    },\n    {\n      \"from\": \"0x21\",\n      \"to\": \"0x1F\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Incremental upsert. Keys already remapped and not named in the request\nkeep their current target, so a client can bind one key without first\nfetching and resending the whole layout.\n\nSending a `from` that is already remapped updates it to the new target\nrather than conflicting. Remapping a key to itself clears that\noverride, which is how a single binding is removed without a DELETE.\n\nThe caller's keyboard is provisioned on first write; there is no\nseparate registration step.\n"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST add mappings — Caps Lock to Left Ctrl",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keyboards/{{keyboard}}/mappings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keyboards",
                "{{keyboard}}",
                "mappings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mappings\": [\n    {\n      \"from\": \"0x39\",\n      \"to\": \"0xE0\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Incremental: keys already remapped and not named here keep their target."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
