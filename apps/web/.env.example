# Cognito hosted UI domain and app client. Both are stack outputs of
# ApexIdentity and neither is secret — a browser app cannot keep a secret,
# which is why the login uses PKCE instead of a client secret.
#
#   aws cloudformation describe-stacks --stack-name ApexIdentity \
#     --query 'Stacks[0].Outputs'
VITE_COGNITO_DOMAIN=https://apex-key-remapping-636616.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=16k15j46dasjhd8okl0vr7kuid

# Where `npm run dev` proxies /api. Defaults to the local .NET API; point it
# at the deployed ALB to run the client against AWS.
VITE_API_PROXY=http://localhost:5080

# The serverless implementation, for the backend toggle. A separate API
# Gateway origin, which is why that stack configures CORS and the .NET
# one does not need to.
VITE_SERVERLESS_API_URL=https://qb3okpgoo6.execute-api.us-east-1.amazonaws.com
