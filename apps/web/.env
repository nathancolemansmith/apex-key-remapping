# Committed on purpose: a reviewer should be able to clone this repository and
# run `npm run dev:web` without a setup step.
#
# Nothing here is secret. A Cognito hosted-UI domain and a public app client id
# are both visible in any browser that performs the login — which is exactly
# why the client uses PKCE rather than a client secret. The rest are localhost.
#
# Vite's precedence is `.env.local` > `.env`, so your own `.env.local` still
# wins if you want different values. CI ignores both and injects the deployed
# stack outputs at build time.

# Cognito. Read back with:
#   aws cloudformation describe-stacks --stack-name ApexIdentity \
#     --query 'Stacks[0].Outputs'
VITE_COGNITO_DOMAIN=https://apex-key-remapping-636616.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=16k15j46dasjhd8okl0vr7kuid

# Where `npm run dev` proxies /api — the local .NET API by default.
# Point it at the deployed ALB to run the client against AWS.
VITE_API_PROXY=http://localhost:5080

# The serverless implementation, for the backend toggle.
#
# Points at the local dev server (`npm run dev:ddb` + `npm run dev:serverless`),
# not the deployed one — otherwise toggling to Serverless while developing
# silently talks to AWS. CI overrides this with the real stack output.
#
# Deliberately NOT proxied through Vite the way /api is. In production the .NET
# API is same-origin via CloudFront and this one genuinely is not, so keeping
# it cross-origin locally exercises the same CORS path that has to work in AWS.
VITE_SERVERLESS_API_URL=http://localhost:3000
